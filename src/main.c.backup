shalini@shalini:~/shellforge$ cat src/lexer.c
#include <ctype.h>
#include <string.h>
#include "lexer.h"

void tokenize(const char *input, TokenList *list)
{
    char word[MAX_TOKEN_LEN];
    int pos = 0;

    int single_quote = 0;
    int double_quote = 0;

    init_token_list(list);

    for (int i = 0; input[i] != '\0'; i++)
    {
        char c = input[i];

        if (c == '\'' && !double_quote)
        {
            single_quote = !single_quote;
            continue;
        }

        if (c == '"' && !single_quote)
        {
            double_quote = !double_quote;
            continue;
        }

        if (c == '\\' && !single_quote)
        {
            if (input[i + 1] != '\0')
            {
                i++;

                if (pos < MAX_TOKEN_LEN - 1)
                    word[pos++] = input[i];
            }
            else
            {
                if (pos < MAX_TOKEN_LEN - 1)
                    word[pos++] = '\\';
            }

            continue;
        }

        if (isspace((unsigned char)c) &&
            !single_quote &&
            !double_quote)
        {
            if (pos > 0)
            {
                word[pos] = '\0';
                add_token(list, TOKEN_WORD, word);
                pos = 0;
            }

            continue;
        }

        if (pos < MAX_TOKEN_LEN - 1)
            word[pos++] = c;
    }

    if (pos > 0)
    {
        word[pos] = '\0';
        add_token(list, TOKEN_WORD, word);
    }

    add_token(list, TOKEN_END, "END");
}
shalini@shalini:~/shellforge$ cat src/main.c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <readline/history.h>
#include <readline/readline.h>
int main(void)
{
// Display a welcome banner when the shell starts
printf("=====================================\n");
printf("Shellforge \n");
printf(" A Unix Style Shell written in C\n");
printf("=====================================\n");
char *line;
while (1)
{
        line = readline("shellforge$ ");

        if (line == NULL)
        {
            printf("Exiting...\n");
            break;
        }

        if (strlen(line) == 0)
        {
            free(line);
            continue;
        }

        add_history(line);

        if (strcmp(line, "exit") == 0)
        {
            free(line);
            printf("Exiting...\n");
            break;
        }

        if (strcmp(line, "history") == 0)
        {
            HIST_ENTRY **history_list_items = history_list();

            printf("\n------ Command History ------\n");

            if (history_list_items != NULL)
            {
                for (int i = 0; history_list_items[i] != NULL; i++)
                {
                    printf("%d %s\n",
                           i + 1,
                           history_list_items[i]->line);
                }
            }

            printf("-----------------------------\n");

            free(line);
            continue;
        }

        TokenList list;

        tokenize(line, &list);
        print_tokens(&list);

        free(line);
    }

    return 0;
}
